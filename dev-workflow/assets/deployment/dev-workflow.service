[Unit]
Description=Event-driven development workflow controller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=devworkflow
Group=devworkflow
WorkingDirectory=/srv/dev-workflow
Environment=PYTHONUTF8=1
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=-/etc/dev-workflow/environment
ExecStart=/usr/bin/python3 -B /opt/dev-workflow/scripts/workflow_service.py serve --state-dir /srv/dev-workflow/control --host 127.0.0.1 --port 8765
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
